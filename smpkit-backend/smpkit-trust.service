# systemd-Unit für das SMP-Kit Trust Backend (ohne Docker).
#
# Installation:
#   sudo useradd -r -s /usr/sbin/nologin smpkit
#   sudo mkdir -p /opt/smpkit /var/lib/smpkit
#   sudo cp trust_server.py licensing.py /opt/smpkit/
#   sudo cp -r web /opt/smpkit/web
#   sudo chown -R smpkit:smpkit /var/lib/smpkit
#   sudo cp smpkit-trust.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now smpkit-trust
#
# Danach hinter nginx/Caddy mit HTTPS betreiben.

[Unit]
Description=SMP-Kit Trust Backend
After=network.target

[Service]
Type=simple
User=smpkit
Group=smpkit
WorkingDirectory=/opt/smpkit
Environment=SMPKIT_HOST=127.0.0.1
Environment=SMPKIT_PORT=8080
Environment=SMPKIT_DB=/var/lib/smpkit/trust.db
# Verkauf / Lizenz:
Environment=SMPKIT_PUBLIC_URL=https://trust.deine-domain.de
Environment=SMPKIT_PRICE_CENTS=499
Environment=SMPKIT_LICENSE_REQUIRED=true
Environment=SMPKIT_MOJANG_AUTH=true
# Stripe (ohne diese: Dev-Modus / simulierter Kauf):
# Environment=STRIPE_SECRET_KEY=sk_live_...
# Environment=STRIPE_WEBHOOK_SECRET=whsec_...
# Environment=SMPKIT_ADMIN_KEY=bitte-aendern
# Impressum/Datenschutz (für /privacy und /gdpr):
# Environment=SMPKIT_OPERATOR_NAME=Dein Name
# Environment=SMPKIT_OPERATOR_EMAIL=du@example.com
# Environment=SMPKIT_OPERATOR_ADDRESS=Straße Nr., PLZ Ort
ExecStart=/usr/bin/python3 /opt/smpkit/trust_server.py
Restart=on-failure
RestartSec=3

# Härtung
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/smpkit

[Install]
WantedBy=multi-user.target
