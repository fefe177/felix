# SMP-Kit Server – Konfiguration
# ================================
# So benutzt du diese Datei:
#   1. Kopiere sie zu  config.env  (ohne ".example")
#   2. Entferne bei den Zeilen, die du brauchst, das führende "#"
#   3. Passe die Werte an und speichere.
# Ohne config.env läuft der Server im lokalen Test-Modus (kein Verkauf, sofort nutzbar).

# --- Grundeinstellungen ---
# Port, auf dem der Server lauscht:
#SMPKIT_PORT=8080
# Speicherort der Datenbank (Standard: data/trust.db):
#SMPKIT_DB=data/trust.db

# --- Verkauf / Lizenzen (nur wenn du wirklich verkaufen willst) ---
# Öffentliche Adresse deines Servers (für die Bezahl-Weiterleitung).
# Lokal:   http://localhost:8080
# Öffentlich z.B. über einen Tunnel:  https://dein-name.trycloudflare.com
#SMPKIT_PUBLIC_URL=http://localhost:8080

# Preis in Cent (499 = 4,99 €) und Währung:
#SMPKIT_PRICE_CENTS=499
#SMPKIT_CURRENCY=eur

# Trust-System nur mit gekaufter Lizenz nutzbar? true/false
# Zum Testen erst auf false lassen, für echten Verkauf auf true:
#SMPKIT_LICENSE_REQUIRED=false

# Stripe-Schlüssel aus deinem Stripe-Dashboard. FEHLEN sie, wird der Kauf
# nur SIMULIERT (Dev-Modus) – gut zum Ausprobieren ohne echtes Geld.
#STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
#STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Optionaler Admin-Schlüssel (voller Zugriff ohne Lizenz, z.B. für dich selbst):
#SMPKIT_ADMIN_KEY=dein-geheimes-passwort
