# Example environment overrides for LocalPilot.
#
# Copy this file to `.env` and uncomment the lines you want to override.
# Variables use the LOCALPILOT_ prefix; nested config keys are joined with "__".
# Environment variables take precedence over both YAML config files
# (defaults < config/default.yaml < --config file < .env / process environment).

# Global log level (DEBUG, INFO, WARNING, ERROR).
# LOCALPILOT_LOG_LEVEL=INFO

# Use the multi-agent orchestrator instead of the single agent (true|false).
# LOCALPILOT_MULTI_AGENT=false

# --- LLM backend ---
# LOCALPILOT_LLM__BACKEND=ollama                 # ollama | lmstudio
# LOCALPILOT_LLM__BASE_URL=http://localhost:11434/v1
# LOCALPILOT_LLM__API_KEY=not-needed
# LOCALPILOT_LLM__MODEL=qwen3:8b
# LOCALPILOT_LLM__TEMPERATURE=0.7
# LOCALPILOT_LLM__MAX_TOKENS=4096
# LOCALPILOT_LLM__REQUEST_TIMEOUT_S=120

# --- Vision / OCR ---
# LOCALPILOT_VISION__ENABLED=true
# LOCALPILOT_VISION__MODEL=qwen2.5vl:7b
# LOCALPILOT_VISION__OCR_ENABLED=true

# --- Memory (SQLite; optional vector store) ---
# LOCALPILOT_MEMORY__DB_PATH=./workspace/localpilot.db
# LOCALPILOT_MEMORY__VECTOR_ENABLED=false
# LOCALPILOT_MEMORY__EMBEDDING_MODEL=                 # set + install sqlite-vec to enable

# --- Browser (Playwright/Chromium) ---
# LOCALPILOT_BROWSER__HEADLESS=false
# LOCALPILOT_BROWSER__DEFAULT_TIMEOUT_MS=30000

# --- Desktop (PyAutoGUI) ---
# LOCALPILOT_DESKTOP__FAILSAFE=true
# LOCALPILOT_DESKTOP__MOVE_DURATION_S=0.2

# --- Terminal (command execution) ---
# LOCALPILOT_TERMINAL__TIMEOUT_S=60
# LOCALPILOT_TERMINAL__WORKDIR=./workspace
# Note: command_blocklist is a list and is best set in a YAML config file.

# --- Safety (safe | balanced | autonomous) ---
# LOCALPILOT_SAFETY__MODE=balanced
# LOCALPILOT_SAFETY__RESTRICT_WRITES_TO_WORKDIR=true

# --- Agent loop ---
# LOCALPILOT_AGENT__MAX_ITERATIONS=12
# LOCALPILOT_AGENT__MAX_REPAIR_ATTEMPTS=2

# --- Control server (localpilot serve) ---
# LOCALPILOT_SERVER__HOST=127.0.0.1
# LOCALPILOT_SERVER__PORT=8765
