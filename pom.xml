<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>eu.bieder</groupId>
    <artifactId>BigMC</artifactId>
    <version>0.3.1</version>
    <packaging>jar</packaging>

    <name>BigMC</name>
    <description>Survival-SMP Plugin (HugoSMP/DonutSMP-Stil)</description>

    <properties>
        <!-- Java 21 wie vorgegeben -->
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <!-- PaperMC Repository fuer die Paper-API -->
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Paper API 1.21.x (nur zur Compile-Zeit, vom Server bereitgestellt) -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.21.4-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <!-- SQLite JDBC Treiber - NICHT mehr ins JAR geshadet, sondern zur Laufzeit
             ueber Papers "libraries" (siehe plugin.yml) geladen. Das vermeidet den
             UnsatisfiedLinkError, den Papers Plugin-Remapper bei geshadeten
             nativen Bibliotheken verursacht. Hier nur "provided" (Compile-Zeit). -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.47.1.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- Hinweis: NuVotifier (Phase 9) wird NICHT als Abhaengigkeit benoetigt.
             Die Anbindung erfolgt per Reflection (siehe VotifierHook), damit das
             Plugin ohne externe Vote-Bibliothek kompiliert und trotzdem mit
             echtem NuVotifier zusammenarbeitet. -->
    </dependencies>

    <build>
        <!-- Ausgabename der fertigen Datei: BigMC.jar -->
        <finalName>BigMC</finalName>

        <plugins>
            <!-- Compiler-Plugin: Java 21 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${java.version}</release>
                </configuration>
            </plugin>
            <!-- Kein Shade mehr noetig: SQLite kommt zur Laufzeit ueber Papers
                 library-loader (plugin.yml -> libraries). -->
        </plugins>

        <resources>
            <!-- Ressourcen filtern, damit ${project.version} in plugin.yml ersetzt wird -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>
</project>
