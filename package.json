{
  "name": "blox-tower-defense-3d",
  "version": "1.0.0",
  "description": "Tower-Defense-Spiel im Roblox-Stil – als Desktop-App (Electron)",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-packager . \"Blox Tower Defense 3D\" --platform=win32 --arch=x64 --out=dist --overwrite",
    "build:mac": "electron-packager . \"Blox Tower Defense 3D\" --platform=darwin --arch=arm64 --out=dist --overwrite",
    "build:linux": "electron-packager . \"Blox Tower Defense 3D\" --platform=linux --arch=x64 --out=dist --overwrite"
  },
  "author": "Felix",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-packager": "^17.1.2"
  }
}
